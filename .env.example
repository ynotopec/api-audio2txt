# Required: comma-separated bearer token(s) accepted by the API.
ASR_API_TOKENS=change-me

# ASR model. Default: openai/whisper-large-v3-turbo
# ASR_MODEL=openai/whisper-large-v3-turbo

# Bind defaults used by run.sh when IP/PORT are not supplied.
# HOST=0.0.0.0
# PORT=8000

# --- Inference ---
# Chunk size handed to the transformers pipeline (Whisper's native window).
# ASR_CHUNK_S=30

# Chunks decoded per forward pass. Raise on large-memory GPUs.
# ASR_BATCH=1

# Max audio accepted, in seconds. Longer input is truncated.
# ASR_MAX_SEC=5400

# Per-request wall-clock budget before returning HTTP 504.
# ASR_TIMEOUT=180

# Per-chunk decode safety valve. The effective budget is computed per request
# from the audio duration (see _decode_budget) and clamped to Whisper's
# 448-position decoder limit; this is the outer cap only.
# ASR_MAX_NEW_TOKENS=440

# Beam width. 1 is greedy and fastest; 5 improves WER at a large latency cost.
# ASR_NUM_BEAMS=1

# Concurrent inference threads. A matching semaphore bounds in-flight GPU work.
# Raise only if the GPU has memory headroom.
# ASR_WORKERS=1

# --- Voice activity detection ---
# Energy-based silence trimming. Cuts encoder work and removes the silence that
# makes Whisper hallucinate. Disable with ASR_VAD=0 to compare.
# ASR_VAD=1
# ASR_VAD_THRESHOLD_DB=-45
# ASR_VAD_MIN_SILENCE_MS=500
# ASR_VAD_SPEECH_PAD_MS=200

# Silence re-inserted between two kept regions when trimming. Splicing speech
# regions flush against each other makes the decoder repeat itself; measured
# +40 % WER without this. Set to 0 to reproduce that behaviour.
# ASR_VAD_JOIN_GAP_MS=300

# --- Service ---
# Requests in flight before the API answers 503 instead of buffering audio.
# ASR_MAX_QUEUE=64

# Keep Whisper's previous-token conditioning across chunks (default 1). Setting
# it to 0 suppresses repetition loops on long noisy audio, at a measured WER
# cost on clean speech.
# ASR_CONDITION_ON_PREV=1

# Run one warmup inference at startup so the first request does not pay
# cudnn autotune. Set to 0 to start faster.
# ASR_WARMUP=1

# Logging default.
# LOG_LEVEL=INFO

# Optional token file, one bearer token per line. Default: auth_tokens.txt
# AUTH_FILE=auth_tokens.txt

# Optional Hugging Face cache path for systems with shared or large storage.
# HF_HOME=/data/huggingface
